# Template for direnv: the build and signing settings of this Mac.
#
# Copy to .envrc, fill in the values, then run `direnv allow` once (and again after every edit).
# Keep `export` on every line: direnv and make only see exported variables.

# --- Apple Developer Team ID (Xcode > Settings > Accounts > Team ID) ---
export DEVELOPMENT_TEAM=

# --- Bundle identifier of the app, e.g. com.example.TaskSwitcher ---
# The Accessibility permission, the saved settings and the login item are tied to it; changing it later
# means granting Accessibility again.
export PROJECT_IDENTIFIER=

# --- Notarization (only needed for `make dmg`) ---
# Either a notarytool keychain profile (recommended), created once with:
#   xcrun notarytool store-credentials my-notary \
#     --apple-id you@example.com --team-id $DEVELOPMENT_TEAM --password APP_SPECIFIC_PW
# export NOTARY_PROFILE=my-notary
#
# …or an Apple ID + app-specific password (from account.apple.com, NOT your Apple ID password).
# export NOTARY_APPLE_ID=you@example.com
# export NOTARY_PASSWORD=xxxx-xxxx-xxxx-xxxx
